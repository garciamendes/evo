# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).

# GitHub OAuth App: só confirma quem está entrando.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Texto aleatório e longo para assinar o cookie de sessão (ex.: openssl rand -base64 32).
AUTH_SECRET=
# Único login do GitHub autorizado a entrar.
ALLOWED_GITHUB_LOGIN=garciamendes

# Repositório PRIVADO onde ficam progresso, respostas e correções.
DATA_REPO=garciamendes/evo-dados
# Token fine-grained com acesso só ao DATA_REPO (Contents: Read and write).
DATA_GITHUB_TOKEN=
